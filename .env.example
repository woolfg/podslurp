# PodcastIndex API credentials (required)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# faster-whisper settings
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Output directories (relative to where you run podslurp)
PODSLURP_OUTPUT_DIR=./transcriptions
PODSLURP_DOWNLOAD_DIR=./downloads

# Speaker diarization (optional)
# Set PODSLURP_DIARIZE=true to identify speakers.
# Requires: uv sync --extra diarize
# PYANNOTE_TOKEN must be a HuggingFace access token with access to
# pyannote/speaker-diarization-3.1 (accept the model terms of use at
# https://huggingface.co/pyannote/speaker-diarization-3.1 first).
PODSLURP_DIARIZE=false
PYANNOTE_TOKEN=
# Optionally constrain the number of speakers (leave blank for auto-detection):
# PODSLURP_DIARIZE_NUM_SPEAKERS=2   # exact count (overrides min/max)
# PODSLURP_DIARIZE_MIN_SPEAKERS=1
# PODSLURP_DIARIZE_MAX_SPEAKERS=4
